{
  "manifest_version": 3,
  "name": "Realtor CRM - WhatsApp Web Companion",
  "version": "1.0.0",
  "description": "WhatsApp Web companion extension for Realtor CRM. Monitors Israeli real estate announcements and syncs them directly to the CRM.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.github.io/*",
    "http://*.github.io/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "dist/whatsapp-observer.js"
      ]
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.github.io/*",
        "http://*.github.io/*"
      ],
      "run_at": "document_idle",
      "js": [
        "dist/crm-bridge.js"
      ]
    }
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Realtor CRM - WhatsApp Web Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
